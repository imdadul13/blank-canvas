# =============================================================================
# ONE SHOT FMGE — Environment Configuration Template
# Duplicate this file as .env (or .env.production) and fill in your secrets.
# =============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Optional: Host URL for self-referential links, webhooks, and absolute URLs
APP_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# AI Intelligence (Google Gemini)
# -----------------------------------------------------------------------------
# Required for dynamic clinical question generation, distractor analysis, and AI cross-checking.
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# PostgreSQL connection string used by the web service and Telegram worker.
# Example: postgres://username:password@hostname:5432/database_name
DATABASE_URL=

# Stable unique labels for one-time import of each service's pre-migration JSON snapshot.
# Render sets these separately for the web and Telegram worker services.
PERSISTENCE_MIGRATION_SOURCE=local
# Set true only after verifying that the legacy service had no local state to import.
PERSISTENCE_ALLOW_EMPTY=false

# -----------------------------------------------------------------------------
# Telegram Integration (MTProto & Bot Ingestion)
# -----------------------------------------------------------------------------
# Required for Telegram channel monitoring, poll/MCQ ingestion, and knowledge bank sync.
# Obtain API ID & Hash from: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 32-byte secret key used for AES-256-GCM encryption of user MTProto sessions at rest.
# Automatically generated on Render or generate with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=

# Firebase ID-token verification and owner-only Telegram / AI-key controls.
FIREBASE_PROJECT_ID=one-shot-fmge
APP_OWNER_UID=
TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Firebase Emulator (Local Development Only)
# Set to "true" to connect Auth to http://127.0.0.1:9099 and Firestore to
# http://127.0.0.1:8080. Production builds never connect to emulators.
# Usage: start emulators first, then run `npm run dev:local`.
# -----------------------------------------------------------------------------
VITE_USE_FIREBASE_EMULATORS=false
